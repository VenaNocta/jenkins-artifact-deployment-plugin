<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<!-- page -->
	<f:entry title="Name" field="name">
		<f:textbox />
	</f:entry>
	<f:entry title="Skip Task when Requirements fail?" field="skipOnFailedCheck">
		<f:checkbox />
	</f:entry>
	<f:entry title="Requirements">
		<f:repeatableHeteroProperty
			field="requirements" hasHeader="true" />
	</f:entry>
	<f:entry title="Tasks">
		<f:repeatableHeteroProperty field="tasks"
			hasHeader="true" />
	</f:entry>
</j:jelly>
