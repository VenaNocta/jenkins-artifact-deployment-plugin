<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form"
	xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
	<!-- page -->
	<div style="display:flex; gap:20px; width:100%;">
		<div style="flex:0 0 auto; min-width:25%">
			<f:entry title="Variable" field="key">
				<f:textbox />
			</f:entry>
		</div>
		<div style="flex:1; min-width:0;">
			<f:entry title="Metadata Keys" field="metaKeyValues">
				<f:textbox />
			</f:entry>
		</div>
	</div>
</j:jelly>
